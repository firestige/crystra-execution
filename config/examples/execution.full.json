{
  "schemaVersion": "execution.config@2.0.0",
  "paths": {
    "repositoryRoot": "/srv/crystra/repository",
    "workspaceRoot": "/srv/crystra/workspaces",
    "allowedWorktreeRoots": ["/srv/crystra/workspaces"],
    "stateRoot": "/var/lib/crystra/execution"
  },
  "workflowSource": {
    "kind": "github",
    "repository": "firestige/crystra-workflow-package",
    "releasesBaseUrl": "https://api.github.com/repos/firestige/crystra-workflow-package/releases",
    "assetPattern": "workflow-package-{name}-{version}.tar.gz"
  },
  "runner": {
    "implementationKey": "runner.v2",
    "host": { "engine": "langgraph" },
    "maxParallelToolCalls": 8
  },
  "observation": {
    "enabled": true,
    "endpoint": "http://127.0.0.1:4318",
    "timeoutMs": 2000,
    "maxBatchRecords": 512,
    "maxBatchBytes": 4194304,
    "flushIntervalMs": 1000,
    "shutdownFlushMs": 5000,
    "serviceName": "crystra-execution"
  },
  "controls": {
    "startupTimeoutMs": 60000,
    "executionTimeoutMs": 7200000,
    "shutdownTimeoutMs": 20000,
    "maxConcurrentDeliveries": 8,
    "allowExplicitRefresh": true,
    "diagnosticMaxBytes": 8192
  },
  "intake": { "maxCorrelationBytes": 512, "maxOutputBytes": 16384 }
}
